{
  "name": "go-account-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:demo": "node scripts/start-demo.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
